<?xml version="1.0" ?>
<!--
  SAUVC arena world.

  Pool depth is 1.6 m, matching the deepest point of the 2026 arena side view
  (docs/sim-visual/reference/arena-2026-finals.png; the real floor slopes from
  1.2 m at the ends to 1.6 m at the centre, and we model the deep section as a
  flat floor). It was previously 2.2 m, which let the vehicle hold depths that
  do not exist in the competition pool.

  Note on water appearance: Ignition Fortress renders with ogre2, whose scene
  implements no fog at all, and gz-sim's RenderUtil never reads <scene><fog>
  either. Writing a fog block here would be silently ignored. Distance
  attenuation, the blue-green cast and scattering therefore live entirely in
  the underwater_camera node (see the `bridge` package), which has the depth
  buffer available and can apply the real image-formation model. Everything
  configured here is the *dry* scene that node then puts water in front of.
-->
<sdf version="1.8">
    <world name="water_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <gravity>0 0 -9.81</gravity>
        <scene>
            <!--
              Indoor natatorium: bright, soft, near-neutral fill. The ambient
              term is high because underwater there is no direction light does
              not come from - multiply-scattered light fills every surface, and
              a single overhead source leaves the vertical pool walls almost
              black, which is not what the venue photographs show.
            -->
            <ambient>0.72 0.74 0.76 1</ambient>
            <background>0.80 0.88 0.92 1</background>
            <shadows>true</shadows>
        </scene>

        <plugin
            filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics">
        </plugin>
        <plugin
            filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands">
        </plugin>
        <plugin
            filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster">
        </plugin>

        <plugin
            filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin
            filename="ignition-gazebo-buoyancy-system"
            name="ignition::gazebo::systems::Buoyancy">
            <graded_buoyancy>
                <default_density>1000</default_density>
                <density_change>
                    <above_depth>0</above_depth>
                    <density>1</density>
                </density_change>
            </graded_buoyancy>
        </plugin>

        <!--
          Overhead hall lighting. Nearly vertical and low-contrast: the venue
          is an indoor pool lit through a diffusing ceiling, so props cast soft
          shadows straight down rather than the long raking ones a sun-like
          light produces.
        -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.75 0.76 0.78 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.15 0.08 -0.98</direction>
        </light>

        <!--
          Two shallow-angle fills so the four pool walls are lit. A directional
          light only reaches surfaces facing it, and the vertical walls face
          four different ways, so these two opposing directions between them
          catch every wall. No shadows: these stand in for scattered light,
          which does not cast any.
        -->
        <light type="directional" name="wall_fill_a">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 5 0 0 0</pose>
            <diffuse>0.30 0.31 0.32 1</diffuse>
            <specular>0 0 0 1</specular>
            <direction>0.82 0.41 -0.41</direction>
        </light>
        <light type="directional" name="wall_fill_b">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 5 0 0 0</pose>
            <diffuse>0.30 0.31 0.32 1</diffuse>
            <specular>0 0 0 1</specular>
            <direction>-0.82 -0.41 -0.41</direction>
        </light>

        <model name="pool_structure">
            <static>true</static>
            <pose>0 0 -1.6 0 0 0</pose>

            <include>
                <uri>model://pool_ground</uri>
                <pose>0 0 0 0 0 0</pose>
            </include>

            <!--
              Walls are 2.0 m tall so they rise 0.4 m above the water line, as
              a pool deck does. The wall texture bakes the gutter and the navy
              waterline band into its top edge.
            -->

            <!-- Long walls (x direction) -->
            <link name="wall_x_pos">
                <pose>12.65 0 1.0 0 0 0</pose>
                <collision name="col">
                <geometry>
                    <box>
                    <size>0.3 16.3 2.0</size>
                    </box>
                </geometry>
                </collision>
                <visual name="vis">
                <geometry>
                    <box>
                    <size>0.3 16.3 2.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.95 0.96 0.97 1</ambient>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <emissive>0 0 0 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://pool_ground/materials/textures/pool_wall_competition.png</albedo_map>
                            <metalness>0.0</metalness>
                            <roughness>0.55</roughness>
                        </metal>
                    </pbr>
                </material>
                </visual>
            </link>

            <link name="wall_x_neg">
                <pose>-12.65 0 1.0 0 0 0</pose>
                <collision name="col">
                <geometry>
                    <box>
                    <size>0.3 16.3 2.0</size>
                    </box>
                </geometry>
                </collision>
                <visual name="vis">
                <geometry>
                    <box>
                    <size>0.3 16.3 2.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.95 0.96 0.97 1</ambient>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <emissive>0 0 0 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://pool_ground/materials/textures/pool_wall_competition.png</albedo_map>
                            <metalness>0.0</metalness>
                            <roughness>0.55</roughness>
                        </metal>
                    </pbr>
                </material>
                </visual>
            </link>

            <!-- Short walls (y direction) -->
            <link name="wall_y_pos">
                <pose>0 8.15 1.0 0 0 0</pose>
                <collision name="col">
                <geometry>
                    <box>
                    <size>25 0.3 2.0</size>
                    </box>
                </geometry>
                </collision>
                <visual name="vis">
                <geometry>
                    <box>
                    <size>25 0.3 2.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.95 0.96 0.97 1</ambient>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <emissive>0 0 0 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://pool_ground/materials/textures/pool_wall_competition.png</albedo_map>
                            <metalness>0.0</metalness>
                            <roughness>0.55</roughness>
                        </metal>
                    </pbr>
                </material>
                </visual>
            </link>

            <link name="wall_y_neg">
                <pose>0 -8.15 1.0 0 0 0</pose>
                <collision name="col">
                <geometry>
                    <box>
                    <size>25 0.3 2.0</size>
                    </box>
                </geometry>
                </collision>
                <visual name="vis">
                <geometry>
                    <box>
                    <size>25 0.3 2.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.95 0.96 0.97 1</ambient>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <emissive>0 0 0 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://pool_ground/materials/textures/pool_wall_competition.png</albedo_map>
                            <metalness>0.0</metalness>
                            <roughness>0.55</roughness>
                        </metal>
                    </pbr>
                </material>
                </visual>
            </link>
        </model>

        <!--
          Water surface, seen from below. Every underwater photograph of the
          arena has this bright ceiling above it; without it the camera sees
          the raw background colour and the frame reads as a dry room. Visual
          only - buoyancy already handles the physical surface at z = 0, and a
          collision here would trap the vehicle underwater.
        -->
        <model name="water_surface">
            <static>true</static>
            <pose>0 0 -0.02 0 0 0</pose>
            <link name="surface">
                <visual name="vis">
                    <!--
                      A box, not a plane: Gazebo's plane visual is single-sided
                      and faces its normal, so a plane here would be invisible
                      from below - which is the only side that ever matters.
                    -->
                    <geometry>
                        <box>
                            <size>25 16 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.78 0.86 1</ambient>
                        <diffuse>0.72 0.86 0.92 1</diffuse>
                        <specular>0.40 0.45 0.48 1</specular>
                        <emissive>0.30 0.40 0.45 1</emissive>
                    </material>
                    <cast_shadows>false</cast_shadows>
                </visual>
            </link>
        </model>

    </world>
</sdf>
