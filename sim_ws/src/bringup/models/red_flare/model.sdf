<?xml version="1.0"?>
<!--
  Communication flare (red), SAUVC 2026 rulebook, task 4:
  "80cm tall, ~1.6cm in diameter, and red in color."

  The rulebook side view (docs/sim-visual/reference/flares-2026.jpg) shows what
  the text leaves out and what the previous model was missing: a white golf
  ball sitting on top of the pole, and a foot the pole stands in. At detection
  range a 1.6 cm pole is only a few pixels wide — the ball is by far the
  largest and most distinctive feature of this prop, so leaving it out made the
  flare effectively invisible to the detector.

  Model origin sits on the pool floor. The flare stays dynamic: knocking it
  over is the scoring action for this task.
-->
<sdf version="1.7">
  <model name="red_flare">
    <static>0</static>
    <allow_auto_disable>1</allow_auto_disable>

    <link name="link_0">
      <inertial>
        <mass>0.8</mass>
        <pose>0 0 0.35 0 0 0</pose>
        <inertia>
          <ixx>0.0427</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0427</iyy><iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <gravity>1</gravity>
      <self_collide>0</self_collide>

      <visual name="foot">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.30 0.02 0.02 1</ambient>
          <diffuse>0.80 0.06 0.06 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="pole">
        <pose>0 0 0.43 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.80</length></cylinder></geometry>
        <material>
          <ambient>0.30 0.02 0.02 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="ball">
        <pose>0 0 0.8515 0 0 0</pose>
        <geometry><sphere><radius>0.0215</radius></sphere></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.97 0.97 0.97 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>

      <collision name="foot_collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
        </surface>
      </collision>

      <collision name="pole_collision">
        <pose>0 0 0.44 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.845</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
