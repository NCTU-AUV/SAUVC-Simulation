<?xml version="1.0"?>
<!--
  Orange flare, SAUVC 2026 rulebook, task 1:
  "~15cm diameter flare with height spanning from bottom to top of the pool,
  and orange in color."

  In the competition photographs (docs/sim-visual/reference/
  orange-flare-2022.jpg) this prop is an inflatable orange marker buoy tethered
  to a black weight plate on the floor — a flat ~15 cm wide blade, not the
  round column the previous model used. The blade profile matters: seen from
  the side it is a wide orange bar, seen edge-on it nearly disappears, and the
  detector was trained on both.

  Model origin sits on the pool floor. Static: any contact with this prop
  aborts the attempt, so it must never be nudged out of place.
-->
<sdf version="1.7">
  <model name="orange_flare">
    <static>1</static>
    <allow_auto_disable>1</allow_auto_disable>

    <link name="link_1">
      <inertial>
        <mass>2.0</mass>
        <pose>0 0 0.10 0 0 0</pose>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <!-- Dive weight anchoring the buoy. -->
      <visual name="weight">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>

      <!--
        Inflatable blade, floor to just under the surface.

        Safety orange, weighted well to the red side. Water strips red far
        faster than green, so a "balanced" orange arrives at the camera as
        olive-yellow: at 3 m the previous 0.97/0.42/0.03 landed on RGB
        (105, 111, 42), which the detector read as a yellow flare. Sampling
        the real prop in docs/sim-visual/reference/orange-flare-2022.jpg gives
        (135, 90, 79) at similar range — red clearly ahead of green — and that
        is what this albedo reproduces once the water is applied.
      -->
      <visual name="blade">
        <pose>0 0 0.79 0 0 0</pose>
        <geometry><box><size>0.15 0.07 1.50</size></box></geometry>
        <material>
          <ambient>0.50 0.13 0.02 1</ambient>
          <diffuse>1.00 0.26 0.05 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
        </material>
      </visual>

      <!-- Dark sealed cuff at the bottom of the buoy. -->
      <visual name="cuff">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry><box><size>0.15 0.075 0.10</size></box></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>

      <collision name="weight_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.04</length></cylinder></geometry>
      </collision>

      <collision name="blade_collision">
        <pose>0 0 0.79 0 0 0</pose>
        <geometry><box><size>0.15 0.07 1.50</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
