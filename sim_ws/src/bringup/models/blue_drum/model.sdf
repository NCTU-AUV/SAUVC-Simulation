<?xml version="1.0"?>
<!--
  Target drum (blue), SAUVC 2026 rulebook, task 2:
  "60cm in diameter and 30cm in depth."

  See red_drum/model.sdf for the scale and base-offset derivation.

  Model origin sits on the pool floor at the drum's centre.
-->
<sdf version="1.7">
  <model name="blue_drum">
    <static>1</static>
    <allow_auto_disable>1</allow_auto_disable>

    <link name="link_1">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.166667</iyy><iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 -0.0433 1.5708 0 0</pose>
      <gravity>1</gravity>
      <self_collide>0</self_collide>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://blue_drum/drum.obj</uri>
            <scale>0.2698 0.2698 0.2698</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.03 0.09 0.24 1</ambient>
          <diffuse>0.10 0.34 0.76 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://blue_drum/drum.obj</uri>
            <scale>0.2698 0.2698 0.2698</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
