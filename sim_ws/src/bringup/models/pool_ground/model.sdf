<?xml version="1.0" ?>
<!--
  Pool floor, 25 x 16 m.

  Gazebo maps a <plane>'s UVs 0..1 across its full extent, so the albedo map is
  a single bake of the entire floor rather than a repeating swatch. That is
  what lets the competition lane lines and end T-markers sit at their true
  metric positions — see scripts/make_pool_textures.py, which produces it.
-->
<sdf version="1.8">
  <model name="pool_ground">
    <static>true</static>
    <link name="pool_floor">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>25 16</size>
          </plane>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>25 16</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.55 0.60 0.63 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <emissive>0 0 0 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://pool_ground/materials/textures/pool_floor_competition.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.55</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
