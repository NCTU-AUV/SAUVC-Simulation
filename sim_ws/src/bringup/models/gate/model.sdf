<?xml version="1.0"?>
<!--
  Navigation gate, SAUVC 2026 rulebook, task 1:
  "150cm wide and 100cm tall gate with striped red and green markings on port
  and starboard sides respectively."

  Stripe pattern and the 4 cm pole diameter come from the rulebook front view
  (docs/sim-visual/reference/gate-2026.jpg). The black cross bar and the white
  PVC ground frame come from the competition photographs (gate-2022.jpg,
  gate+flare-2022.jpg), where the gate always stands in such a frame — that
  frame is part of what the shipped detector was trained on, so it earns its
  place here even though the rulebook does not spell it out.

  Model origin sits on the pool floor, centred between the poles.
-->
<sdf version="1.8">
  <model name="gate">
    <static>true</static>

    <!-- Port pole: red banded with black, white shoe at the bottom. -->
    <link name="left_post">
      <pose>-0.75 0 0 0 0 0</pose>

      <visual name="shoe">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <visual name="band_colour_0">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.35 0.03 0.03 1</ambient>
          <diffuse>0.85 0.08 0.08 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_0">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_1">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.35 0.03 0.03 1</ambient>
          <diffuse>0.85 0.08 0.08 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_1">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_2">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.35 0.03 0.03 1</ambient>
          <diffuse>0.85 0.08 0.08 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_2">
        <pose>0 0 0.90 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_3">
        <pose>0 0 0.975 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.35 0.03 0.03 1</ambient>
          <diffuse>0.85 0.08 0.08 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
      </collision>
    </link>

    <!-- Starboard pole: green banded with black. -->
    <link name="right_post">
      <pose>0.75 0 0 0 0 0</pose>

      <visual name="shoe">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <visual name="band_colour_0">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.30 0.05 1</ambient>
          <diffuse>0.10 0.75 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_0">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_1">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.30 0.05 1</ambient>
          <diffuse>0.10 0.75 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_1">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_2">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.30 0.05 1</ambient>
          <diffuse>0.10 0.75 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="band_black_2">
        <pose>0 0 0.90 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="band_colour_3">
        <pose>0 0 0.975 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.30 0.05 1</ambient>
          <diffuse>0.10 0.75 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
      </collision>
    </link>

    <!-- Black cross bar at 100 cm. -->
    <link name="top_bar">
      <pose>0 0 1.0 0 1.5708 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.02</radius><length>1.54</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.02</radius><length>1.54</length></cylinder></geometry>
      </collision>
    </link>

    <!-- White PVC ground frame the poles are bolted into. -->
    <link name="base_frame">
      <pose>0 0 0.025 0 0 0</pose>
      <visual name="rail_port">
        <pose>-0.75 0 0 0 0 0</pose>
        <geometry><box><size>0.05 1.10 0.05</size></box></geometry>
        <material>
          <ambient>0.80 0.82 0.83 1</ambient>
          <diffuse>0.94 0.95 0.96 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rail_starboard">
        <pose>0.75 0 0 0 0 0</pose>
        <geometry><box><size>0.05 1.10 0.05</size></box></geometry>
        <material>
          <ambient>0.80 0.82 0.83 1</ambient>
          <diffuse>0.94 0.95 0.96 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rail_near">
        <pose>0 -0.55 0 0 0 0</pose>
        <geometry><box><size>1.55 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.80 0.82 0.83 1</ambient>
          <diffuse>0.94 0.95 0.96 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rail_far">
        <pose>0 0.55 0 0 0 0</pose>
        <geometry><box><size>1.55 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.80 0.82 0.83 1</ambient>
          <diffuse>0.94 0.95 0.96 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
