<?xml version="1.0"?>
<!--
  Target drum (red), SAUVC 2026 rulebook, task 2:
  "60cm in diameter and 30cm in depth."

  drum.obj spans 2.2242 x 1.0963 units, so a uniform 0.2698 scale lands on
  59.99 cm across by 29.58 cm deep — the mesh proportions already match the
  spec, only the scale was wrong (0.4 gave an 89 cm drum, 48% oversized).

  The mesh's base sits 0.1602 units above its own origin, which after scaling
  is 4.33 cm; the link is dropped by that much so the drum rests exactly on
  the pool floor when spawned at floor height. The link rotation maps the
  mesh's +y axis to world +z.

  Model origin sits on the pool floor at the drum's centre.
-->
<sdf version="1.7">
  <model name="red_drum">
    <static>1</static>
    <allow_auto_disable>1</allow_auto_disable>

    <link name="link_2">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.166667</iyy><iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 -0.0433 1.5708 0 0</pose>
      <gravity>1</gravity>
      <self_collide>0</self_collide>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://red_drum/drum.obj</uri>
            <scale>0.2698 0.2698 0.2698</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.24 0.04 0.04 1</ambient>
          <diffuse>0.78 0.13 0.11 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://red_drum/drum.obj</uri>
            <scale>0.2698 0.2698 0.2698</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
